ENVIRONMENT=development

POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me
POSTGRES_DB=budget
# Your own PostgreSQL server (not managed by docker compose).
# "localhost" is used when running backend tools on your PC; the backend container reaches
# the same server through host.docker.internal (override with DOCKER_POSTGRES_HOST).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Database used by pytest; created automatically if the user has CREATEDB.
POSTGRES_TEST_DB=budget_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
